# copy to deploy/.env and edit
BEELINE_DB_PASSWORD=change-me
BEELINE_PORT=8080
BEELINE_BUCKET=/srv/beeline/bucket
BEELINE_PGDATA=/srv/beeline/pgdata
BEELINE_REGION=gujarat
# 1 = Fetch LULCs may start the LULC model plugins (GPU); 0 = stored outputs only
BEELINE_RUN_MODELS=1
# Licensed imagery acquisition (Images screen -> Fetch imagery). Never passed to model processes.
BEELINE_ESRI_TOKEN=
BEELINE_WAYBACK_RELEASE=26334
BEELINE_WAYBACK_RELEASE_DATE=2026-08-05
BEELINE_PC_SUBSCRIPTION_KEY=
BEELINE_TAG=latest
